{% extends 'layout.html.twig' %}
{% trans_default_domain 'payment' %}

{# Defines specific variables #}
{% set title = 'label.basket'|trans %}
{% set summarySocialNetwork = 'label.basket'|trans %}

{% block content %}
    <twig:c975LPayment:Basket:TestMode/>
    {% if null != basket %}
        {% if "display" == action %}
            <div data-controller="basket" id="basket-page">
                <twig:c975LPayment:Basket:Display basket="{{ basket }}" readonly="false"/>
                <twig:c975LPayment:Basket:Message/>
                <twig:c975LPayment:Basket:Buttons basket="{{ basket }}"/>
                {# The markup belongs to whichever bundle recommends, this one only saying where it goes on the page (see BasketRecommendationProviderInterface) #}
                {% if recommendationsTemplate is not null and recommendations is not empty %}
                    {# Without the page's own context, as the component call it replaces had none: the page sets a "title" of its own, which the strip would otherwise take for its heading #}
                    {{ include(recommendationsTemplate, {'recommendations': recommendations}, with_context = false) }}
                {% endif %}
            </div>
        {% elseif "validate" == action %}
            <div data-controller="basket" id="basket-page">
                <twig:c975LPayment:Basket:Display basket="{{ basket }}" readonly="true"/>
                <twig:c975LPayment:Basket:Validation basket="{{ basket }}" form="{{ form }}"/>
            </div>
        {% elseif "paid" == action %}
            {% set confirmed = basket.status in ['paid', 'shipped'] %}
            <twig:c975LPayment:Basket:PaidInfos number="{{ basket.number }}" confirmed="{{ confirmed }}"/>
            {% if confirmed %}
                <twig:c975LPayment:Basket:TrackOrder basket="{{ basket }}"/>
                <twig:c975LPayment:Basket:Delivery basket="{{ basket }}"/>
                {# The files are handed over here too, so a buyer whose email never arrived is not left without them #}
                <twig:c975LPayment:Basket:Downloads downloads="{{ downloads }}"/>
            {% endif %}
            <twig:c975LPayment:Basket:Display basket="{{ basket }}" readonly="true"/>
            {% if confirmed %}
                <twig:c975LPayment:Basket:GiftCards basket="{{ basket }}"/>
            {% endif %}
            <twig:c975LPayment:Basket:MessageUser message="{{ basket.message }}"/>
            {# Offered once the payment went through and never before it: nothing competes with the checkout itself. "app.user" is read here and not in the component, which is also rendered into an email, where there is no visitor to ask about #}
            {% if confirmed and app.user is null %}
                <twig:c975LPayment:Basket:AccountInvitation basket="{{ basket }}"/>
            {% endif %}
            <twig:c975LPayment:Basket:ContinueShoppingButton/>
        {% endif %}
    {# Empty basket #}
    {% else %}
        <twig:c975LPayment:Basket:Empty/>
        <twig:c975LPayment:Basket:ContinueShoppingButton/>
    {% endif %}
    {# Empty basket for javascript use #}
    <template id="empty-basket-template">
        <twig:c975LPayment:Basket:Empty/>
        <twig:c975LPayment:Basket:ContinueShoppingButton/>
    </template>
{% endblock %}

{% block share %}
{% endblock %}