{# <twig:c975LPayment:Basket:Downloads downloads="{{ downloads }}"/> #}
{% trans_default_domain 'payment' %}

{# The section is left out entirely when no bundle sells files, rather than drawn empty #}
{% if downloads is not empty %}
    <h2>{{ 'label.my_downloads'|trans }}</h2>
    <p>{{ 'text.downloads_same_as_email'|trans }}</p>
    {% for download in downloads %}
        <p>
            <a href="{{ download.url }}">{{ download.title }}</a>
            {% if download.size %}({{ (download.size / (1024 * 1024))|number_format(2) }} MB){% endif %}
            {# Each file carries its own date: they are made as the order is delivered, but a retried send can leave one a day behind the others #}
            {% if download.expiresAt %}
                <span class="text-muted">{{ 'text.download_expires_on'|trans({'%date%': download.expiresAt|date('d/m/Y')}) }}</span>
            {% endif %}
        </p>
    {% endfor %}
{% endif %}
