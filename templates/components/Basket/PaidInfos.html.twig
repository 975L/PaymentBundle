{# <twig:c975LPayment:Basket:PaidInfos number="{{ basket.number }}" confirmed="{{ basket.status in ['paid', 'shipped'] }}"/> #}
{% trans_default_domain 'payment' %}
{# The customer reaching this page is not proof their payment went through: the provider may have been unreachable on the way back, and its webhook confirms the order a moment later. Thanking them for an order that is not one yet is the very thing this page used to do #}
{% if confirmed|default(true) %}
    <p class="text text-center lead">{{ 'label.thanks_shopping'|trans }}</p>
    <p class="text text-center">{{ 'label.basket_thanks'|trans }}</p>
    <p class="text text-center">{{ 'label.follow_up'|trans }}</p>
{% else %}
    <p class="text text-center lead">{{ 'label.payment_confirming'|trans }}</p>
    <p class="text text-center">{{ 'label.payment_confirming_info'|trans }}</p>
{% endif %}
<h2>{{ 'label.order_number'|trans }}</h2>
<p class="text text-center"><strong>{{ number }}</strong></p>
