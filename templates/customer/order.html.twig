{% extends 'layout.html.twig' %}
{% trans_default_domain 'payment' %}

{# Defines specific variables #}
{% set title = 'label.order'|trans ~ ' ' ~ basket.number %}
{% set summarySocialNetwork = title %}
{# No indexing: the customer's own order, behind the firewall - said all the same, as the account pages are #}
{% set robots = 'noindex, nofollow' %}

{% block content %}
    <h1>{{ 'label.order'|trans }} {{ basket.number }}</h1>
    <p><a href="{{ localized_path('customer_orders') }}">{{ 'label.back_to_orders'|trans }}</a></p>
    <twig:c975LPayment:Basket:Refunded basket="{{ basket }}"/>

    {# A number is drawn when the order is paid, so an order still being settled has no invoice to offer #}
    {% if basket.invoiceNumber %}
        <p><a href="{{ path('basket_invoice_pdf', {'number': basket.number, 'securityToken': basket.securityToken}) }}">{{ 'label.download_invoice'|trans }} {{ basket.invoiceNumber }}</a></p>
    {% endif %}
    {% if basket.creditNoteNumber %}
        <p><a href="{{ path('basket_credit_note_pdf', {'number': basket.number, 'securityToken': basket.securityToken}) }}">{{ 'label.download_credit_note'|trans }} {{ basket.creditNoteNumber }}</a></p>
    {% endif %}

    <twig:c975LPayment:Basket:TrackOrder basket="{{ basket }}"/>
    <twig:c975LPayment:Basket:Delivery basket="{{ basket }}"/>
    <twig:c975LPayment:Basket:Display basket="{{ basket }}" readonly="true"/>
    <twig:c975LPayment:Basket:MessageUser message="{{ basket.message }}"/>

    <twig:c975LPayment:Basket:Downloads downloads="{{ downloads }}"/>
    {# The cards a refunded order bought are deactivated with it, and are no longer something to hand on #}
    {% if basket.status.isSettled %}
        <twig:c975LPayment:GiftCard:Cards basket="{{ basket }}"/>
    {% endif %}
{% endblock %}
