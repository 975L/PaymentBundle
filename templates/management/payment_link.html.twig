{# Writes one order through BasketService::createPaymentLink(), laid out like EasyAdmin's own "new" page: a form rendered without that theme comes out unstyled inside the dashboard #}
{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form with ea() is not null and ea().crud is not null ? ea().crud.formThemes : ['@EasyAdmin/crud/form_theme.html.twig'] only %}

{% block body_id 'ea-new-payment-link' %}
{% block body_class 'ea-new' %}

{% block head_javascript %}
    {{ parent() }}
    {# EasyAdmin's own widgets are what this script drives, so it is only asked for where the dashboard's context exists at all #}
    {% if ea() is not null %}
        {# The nonce guard EasyAdmin itself applies: the sites running this bundle serve a CSP with no unsafe-inline #}
        {% guard function csp_nonce %}
            <script src="{{ asset('form.js', ea().assets.defaultAssetPackageName) }}" nonce="{{ csp_nonce('script') }}"></script>
        {% else %}
            <script src="{{ asset('form.js', ea().assets.defaultAssetPackageName) }}"></script>
        {% endguard %}
    {% endif %}
{% endblock %}

{% block content_title %}{{ 'label.payment_link'|trans({}, 'payment') }}{% endblock %}

{% block main %}
    <p class="content-help">{{ 'description.payment_link'|trans({}, 'payment') }}</p>

    {# The address of the order just written, shown once and on the page that wrote it - it is what the admin came for, and it is copied rather than read #}
    {% for url in app.flashes('payment_link_url') %}
        <div class="alert alert-success">
            <p>{{ 'label.payment_link_url'|trans({}, 'payment') }}</p>
            <p><a href="{{ url }}" target="_blank" rel="noopener">{{ url }}</a></p>
        </div>
    {% endfor %}

    {{ form(form) }}
{% endblock %}
