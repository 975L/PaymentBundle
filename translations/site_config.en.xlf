        <body>
            <trans-unit id="ck17EZz">
                <source>description.payment_email_attachments</source>
                <target>Set to true for order emails to carry the documents ticked on them in the email builder: invoice and terms of sale. At false, nothing is attached</target>
            </trans-unit>
            <trans-unit id=".WVUEkd">
                <source>description.payment_gateway</source>
                <target>The provider the shop charges with, eg. stripe or revolut</target>
            </trans-unit>
            <trans-unit id="URSfS7x">
                <source>description.payment_gift_card_validity</source>
                <target>How long a gift card stays spendable, in months from its purchase (12 for a year). 0 for a card that never expires. The date belongs on the card handed to the customer.</target>
            </trans-unit>
            <trans-unit id="R2..YBF">
                <source>description.payment_link_vat_rate</source>
                <target>Rate applied to the payment links written in the back-office, e.g. 20 for 20%. 0 if you charge no VAT.</target>
            </trans-unit>
            <trans-unit id="wgKNCR_">
                <source>description.payment_share_validity</source>
                <target>How many days an order the customer has asked to be offered stays payable through the shared link. The delay is told to the customer, not enforced: the order is really removed after 30 days if it goes unpaid.</target>
            </trans-unit>
            <trans-unit id="i415WZO">
                <source>description.payment_test_mode</source>
                <target>Set to true to charge with the provider test keys: nobody is charged and a banner tells the customer</target>
            </trans-unit>
            <trans-unit id="IMPOxrd">
                <source>description.revolut_secret</source>
                <target>Your production Revolut Merchant API secret key (sk_...)</target>
            </trans-unit>
            <trans-unit id="quFPKra">
                <source>description.revolut_secret_test</source>
                <target>Revolut Merchant API sandbox secret key, used when test payments are enabled</target>
            </trans-unit>
            <trans-unit id="uJ9hn3Q">
                <source>description.revolut_webhook_secret</source>
                <target>Production Revolut webhook signing secret, handed over once, when the webhook is created</target>
