                <target>Código ISO de 3 letras de la moneda, ej. EUR</target>
            </trans-unit>
            <trans-unit id="XiiF70c">
                <source>description.shop_email_bcc</source>
                <target>Dirección de correo en copia oculta (CCO) de la tienda</target>
            </trans-unit>
            <trans-unit id="WDXIVjK">
                <source>description.shop_email_bcc_name</source>
                <target>Nombre asociado a la dirección de correo para CCO</target>
            </trans-unit>
            <trans-unit id="wf5xcq5">
                <source>description.shop_email_from</source>
                <target>Dirección de correo desde la que se envían los correos</target>
            </trans-unit>
            <trans-unit id="3EbsHJJ">
                <source>description.shop_email_from_name</source>
