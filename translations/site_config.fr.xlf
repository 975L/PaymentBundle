            <trans-unit id="elctTGN">
                <source>description.apple_app_id</source>
                <target>Le numéro de l'appli dans App Store Connect (Informations sur l'app), sous lequel les produits in-app sont créés</target>
            </trans-unit>
            <trans-unit id="VL8DzOy">
                <source>description.apple_bundle_id</source>
                <target>Le bundle id de l'appli sur l'App Store (ex. com.exemple.app) : une transaction d'une autre appli est refusée</target>
            </trans-unit>
            <trans-unit id="h1APydX">
                <source>description.apple_iap_key_id</source>
                <target>L'identifiant de la clé de type In-App Purchase, qui vérifie les achats auprès de l'App Store Server API</target>
            </trans-unit>
            <trans-unit id="boipf6t">
                <source>description.apple_iap_private_key</source>
                <target>Le contenu du fichier SubscriptionKey_XXXX.p8 de la clé In-App Purchase, de -----BEGIN à -----END</target>
            </trans-unit>
            <trans-unit id="i1Ax27L">
                <source>description.apple_issuer_id</source>
                <target>L'Issuer ID affiché dans App Store Connect, Utilisateurs et accès, Intégrations, commun aux deux clés</target>
            </trans-unit>
            <trans-unit id="sbvtbHG">
                <source>description.apple_key_id</source>
                <target>L'identifiant de la clé API d'équipe (accès Admin ou App Manager), qui écrit les produits in-app</target>
            </trans-unit>
